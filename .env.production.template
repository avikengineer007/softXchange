# =============================================================================
# softXchange Production Environment Configuration Template
# Copy this file to .env.production (DO NOT COMMIT .env.production TO VERSION CONTROL)
# =============================================================================

# Core Environment
ENVIRONMENT=production
DOMAIN=softxchange.com

# ── Database Credentials ─────────────────────────────────────────────────────
# Single managed PostgreSQL instance with dedicated per-service logical databases
POSTGRES_USER=softxchange_prod
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_SECURE_POSTGRES_PASSWORD_64_CHARS
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

DATABASE_URL_AUTH=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/softxchange_auth
DATABASE_URL_LISTINGS=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/softxchange_listings
DATABASE_URL_PAYMENTS=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/softxchange_payments
DATABASE_URL_SCAN=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/softxchange_scan

# ── Cryptographic Keypairs (RS256) ───────────────────────────────────────────
# Run `python scripts/rotate-secrets.py` to generate clean RSA keypairs
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public.pem

# ── Inter-Service Security ───────────────────────────────────────────────────
# 64-character hex secret for HMAC-SHA256 inter-service KYC webhook verification
INTERNAL_SERVICE_SECRET=CHANGE_ME_GENERATE_64_HEX_CHAR_HMAC_SECRET

# ── Administrator Provisioning ───────────────────────────────────────────────
# Single-use operator code for elevating the first admin user.
# MUST NOT MATCH 'sx_admin_sec_9f7a28e4c19d4b8e8f2a1b3c4d5e6f7a'. Min 32 chars.
ADMIN_PROVISIONING_CODE=CHANGE_ME_GENERATE_FRESH_SX_ADMIN_CODE
ADMIN_CODE_EXPLICITLY_ROTATED=true

# ── Stripe Live Configuration ────────────────────────────────────────────────
# Real production Stripe keys issued from Stripe Dashboard in live mode
STRIPE_SECRET_KEY=sk_live_CHANGE_ME_REAL_STRIPE_LIVE_RESTRICTED_KEY
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME_REAL_STRIPE_LIVE_WEBHOOK_SIGNING_SECRET

# ── Security Scanner Policy ──────────────────────────────────────────────────
# Set to 'false' to fail closed on OSV network failures, or 'true' to fail open
SCAN_OSV_FAIL_OPEN=false

# ── Storage Credentials ──────────────────────────────────────────────────────
MINIO_ROOT_USER=softxchange_storage_admin
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_STORAGE_SECRET_PASSWORD

# ── Transactional Email (Resend) ─────────────────────────────────────────────
# IMPORTANT OPERATIONAL REQUIREMENT:
# 1. Register domain 'softxchange.com' in Resend dashboard (https://resend.com/domains).
# 2. Add Resend's provided DNS records (DKIM TXT, SPF TXT, MX) in your DNS registrar.
# 3. Verify status shows 'Verified' before sending production traffic to avoid spam filtering.
EMAIL_PROVIDER_API_KEY=re_CHANGE_ME_REAL_RESEND_API_KEY
EMAIL_FROM_ADDRESS=noreply@softxchange.com
EMAIL_FROM_NAME=softXchange
FRONTEND_URL=https://softxchange.com
EMAIL_TEST_MODE=false
